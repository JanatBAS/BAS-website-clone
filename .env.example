# Environment variables
# The first three are required for the admin panel; CRON_SECRET is required
# for the Meetup sync. Locally, leave BLOB_READ_WRITE_TOKEN empty unless you
# need admin data: with the production token, dev and build use the live store.

# bcrypt hash of admin password
# Generate with: node -e "require('bcryptjs').hash('your-password',12).then(console.log)"
ADMIN_PASSWORD_HASH=

# Secret key for signing JWT tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Vercel Blob read/write token
# Auto-created when connecting a Blob store in the Vercel dashboard
BLOB_READ_WRITE_TOKEN=

# Required for the daily Meetup sync cron (the endpoint refuses requests without it)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
